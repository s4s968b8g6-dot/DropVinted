# Copie ce fichier en .env.local (en local) ou mets ces variables dans Vercel.
# Ne mets JAMAIS tes vraies clés dans ce fichier-ci.

# --- IA (obligatoire pour estimer le marché et rédiger les fiches) ---
AI_PROVIDER=gemini                 # gemini (gratuit) ou anthropic (payant)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest   # change-le si Google renomme ses modèles
ANTHROPIC_API_KEY=                 # seulement si AI_PROVIDER=anthropic
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Sources produits ---
SOURCE_PROVIDER=cj                 # cj | ai_web | manual
CJ_API_KEY=                        # la clé complète, ex. CJ1234567@api@xxxxxxxx

# --- Réglages (optionnels) ---
USD_EUR_RATE=0.90                  # CJ affiche ses prix en dollars
CJ_SHIPPING_EUR=4.5                # livraison estimée quand CJ ne donne pas "livraison gratuite"
MAX_WEB_SEARCHES=5                 # limite de recherches web par appel IA (pour Claude)
